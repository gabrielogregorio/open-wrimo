# Local MongoDB from docker compose (see README). Keep this to work offline.
MONGODB_URI=mongodb://openwrimo:openwrimo-local-password@localhost:27017/?authSource=admin
MONGODB_DB=openwrimo

# Point to a cluster online only when you want to, for example MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=openwrimo

# Public address of the app. https:// turns on secure cookies.
APP_URL=http://localhost:8920

# true only behind a reverse proxy you control, so X-Forwarded-For feeds the per-address rate limit.
TRUST_PROXY=false

# Credentials for the local container created by docker compose.
MONGO_ROOT_USERNAME=openwrimo
MONGO_ROOT_PASSWORD=openwrimo-local-password

# Where images (covers, post pictures) go: local writes to LOCAL_UPLOADS_DIR and serves them at /media.
STORAGE_DRIVER=local
LOCAL_UPLOADS_DIR=public/uploads

# Cloudinary, only when you want it: set STORAGE_DRIVER=cloudinary and the address from your Cloudinary console.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_FOLDER=openwrimo

# Signs the access tokens (JWT). Use at least 32 random characters, for example: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more
