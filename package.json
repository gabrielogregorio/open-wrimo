{
  "name": "openwrimo",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "A calm reading log: keep your shelf, track pages and bookmark passages",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev --port 8920",
    "build": "next build",
    "start": "next start --port 8920",
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose down",
    "lint": "eslint . && next typegen && tsc -p .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "unit": "vitest",
    "unit:coverage": "vitest run --coverage",
    "e2e": "pnpm run build && pnpm run e2e:built",
    "e2e:built": "playwright test && pnpm run e2e:lighthouse && pnpm run e2e:resources",
    "e2e:features": "playwright test",
    "demo:record": "start-server-and-test _serve_e2e http-get://127.0.0.1:8921/api/health _demo",
    "images:owners": "node --import ./scripts/ts-paths.mjs scripts/migrate-image-owners.mts",
    "e2e:lighthouse": "start-server-and-test _serve_e2e http-get://127.0.0.1:8921/api/health _lighthouse",
    "e2e:resources": "start-server-and-test _serve_e2e http-get://127.0.0.1:8921/api/health _resources",
    "check:all": "pnpm run format:check && pnpm run lint && pnpm run unit:coverage && pnpm run e2e",
    "_serve_e2e": "node scripts/serve-e2e.mts",
    "_lighthouse": "node scripts/lighthouse.mts",
    "_resources": "node scripts/resource-usage.mts",
    "_demo": "node scripts/record-demo.mts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "jose": "^6.2.15",
    "lucide-react": "^1.66.0",
    "mongodb": "^7.8.0",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.6.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
